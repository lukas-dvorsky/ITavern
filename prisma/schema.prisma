// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
     url      = env("DATABASE_URL") 
}

//============================
//          ENUMS
//============================
enum Roles {
    USER
    ADMIN
}
//============================
//          TABLES
//===========================

model LectureHierarchy {
  id          Int       @id @default(autoincrement())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublic    Boolean   @default(false)

  order       String    @default("[]")

  createdById String
  createdBy   User @relation("LectureCreatedBy", fields: [createdById], references: [id])

  updatedById String
  updatedBy   User @relation("LectureUpdatedBy", fields: [updatedById], references: [id])

  // hierarchy
  HierarchyParentId Int?
  hierarchyParent   LectureHierarchy? @relation("LectureHierarchyChildren", fields: [HierarchyParentId], references: [id], onDelete: Cascade)
  hierarchyChildren LectureHierarchy[] @relation("LectureHierarchyChildren")
}

model MarkdownBlock {
  id        Int      @id @default(autoincrement())
  name      String
  content   String?  @db.Text @default("# Nadpis")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User @relation("BlockCreatedBy", fields: [createdById], references: [id])

  updatedById String
  updatedBy   User @relation("BlockUpdatedBy", fields: [updatedById], references: [id])
}


// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Roles      @default(USER)

  accounts      Account[]
  sessions      Session[]

  // reverse relations
  lecturesCreated LectureHierarchy[] @relation("LectureCreatedBy")
  lecturesUpdated LectureHierarchy[] @relation("LectureUpdatedBy")
  blocksCreated   MarkdownBlock[]    @relation("BlockCreatedBy")
  blocksUpdated   MarkdownBlock[]    @relation("BlockUpdatedBy")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
